# ---------- Core ----------
NODE_ENV=development
PORT=5000
# MongoDB MUST be a replica set (transactions). Atlas free tier (M0) works.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/VersaDoc?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173

# ---------- Auth ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# ---------- Documents ----------
MAX_DOCUMENT_BYTES=512000

# ---------- Storage & performance (Stage 2 / Stage 3 knobs) ----------
# Store a full snapshot every N commits; commits in between store only a delta.
SNAPSHOT_INTERVAL=20
# Reconstructed versions kept in memory (0 = off, Stage 1 baseline).
CONTENT_CACHE_SIZE=0
# Worker threads for big diffs/merges so they never block the event loop (0 = run inline).
DIFF_WORKERS=0
# Documents with more lines than this are diffed in a worker (if DIFF_WORKERS > 0).
WORKER_THRESHOLD_LINES=2000
# Myers diff gives up (and falls back to a coarse diff) beyond this many edits.
MAX_DIFF_EDITS=20000
